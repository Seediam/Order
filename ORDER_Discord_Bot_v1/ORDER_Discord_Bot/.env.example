# Token em Discord Developer Portal → Bot. Mantenha em segredo.
DISCORD_TOKEN=COLE_O_TOKEN_AQUI

# Opcional mas RECOMENDADO: ID do servidor ORDER para comandos imediatos.
# Ative Modo Desenvolvedor no Discord e copie o ID do servidor.
GUILD_ID=

# Opcional: link de um post/canal com artes-modelo do ORDER.
ORDER_REFERENCES_URL=

# Ponte local: use a mesma chave aleatória do servidor tabletop (mínimo 32 caracteres).
TABLETOP_BRIDGE_SECRET=
TABLETOP_BRIDGE_PORT=4190

# Página-livro de registro aberta pelo botão do painel (padrão: GitHub Pages do ORDER).
ORDER_REGISTRO_URL=https://seediam.github.io/Order/registro.html
